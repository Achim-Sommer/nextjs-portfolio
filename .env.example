NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id-here
GITHUB_TOKEN=dein_github_token
WAKATIME_API_KEY=dein_wakatime_api_key
NEXT_PUBLIC_UMAMI_URL=https://ihre-umami-domain.com/script.js
NEXT_PUBLIC_SITE_URL=Domain

# Kontaktformular (/kontakt -> /api/contact)
# API-Key aus dem Resend-Dashboard, Domain muss dort verifiziert sein
RESEND_API_KEY=re_dein_resend_api_key
# Absender - muss zu einer in Resend verifizierten Domain gehoeren
CONTACT_FROM_EMAIL=Kontaktformular <kontakt@achimsommer.com>
# Empfaenger der Formularnachrichten
CONTACT_TO_EMAIL=imprint@achimsommer.com
